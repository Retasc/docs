{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Retasc",
  "description": "A persistent, dependency-aware, leased work queue that a fleet of AI agents pulls from, with server-enforced correctness.",
  "colors": {
    "primary": "#1a1a1a",
    "light": "#f0f0f0",
    "dark": "#1a1a1a"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#E8E4DF",
      "dark": "#0a0a0a"
    }
  },
  "styling": {
    "codeblocks": "system"
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "display": "header",
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://retasc.com"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "onboarding-owner",
          "onboarding-member"
        ]
      },
      {
        "group": "How it works",
        "pages": [
          "claims-are-leases",
          "dispatch",
          "review"
        ]
      },
      {
        "group": "Connectors",
        "pages": [
          "notifications",
          "sync",
          "migrate"
        ]
      },
      {
        "group": "Pricing & billing",
        "pages": [
          "pricing",
          "funding",
          "billing-states"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "cli",
          "mcp-tools",
          "auth",
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://retasc.com"
      },
      {
        "label": "Guides",
        "href": "https://retasc.com/guides"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/Retasc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login →",
      "href": "https://dash.retasc.com"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Retasc",
        "items": [
          {
            "label": "Home",
            "href": "https://retasc.com"
          },
          {
            "label": "Guides",
            "href": "https://retasc.com/guides"
          },
          {
            "label": "Dashboard",
            "href": "https://dash.retasc.com"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/Retasc"
          },
          {
            "label": "Changelog",
            "href": "/changelog"
          }
        ]
      }
    ],
    "socials": {
